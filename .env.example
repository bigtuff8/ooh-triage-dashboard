# Zendesk API (required)
ZENDESK_SUBDOMAIN=theairedalegroup
ZENDESK_EMAIL=
ZENDESK_API_TOKEN=

# ThingsBoard
TB_BASE_URL=
TB_USERNAME=
TB_PASSWORD=

# Tuya Cloud
TUYA_CLIENT_ID=
TUYA_CLIENT_SECRET=
TUYA_BASE_URL=https://openapi.tuyaeu.com

# Salus (AWS Cognito)
SALUS_USERNAME=
SALUS_PASSWORD=
SALUS_COGNITO_REGION=eu-west-1

# Intesis / AC Cloud
INTESIS_TOKEN=

# Read-only mode (blocks all writes)
READ_ONLY=true

# Server
PORT=3001
