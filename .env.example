# OOH Dashboard configuration — structure only, never commit real values.
# Full reference: docs/CONFIGURATION.md

PORT=3001
APP_ORIGIN=http://localhost:3001
AUTH_MODE=dev            # oidc (production) | dev (non-production only)
DATA_MODE=fixture        # live | fixture
SESSION_SECRET=

# Airedale B2C OIDC (AUTH_MODE=oidc — values from Spencer, SD-545 model)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
#OIDC_SCOPE=openid profile email
#OIDC_ROLE_CLAIM=extension_Role
#OIDC_ROLE_MAP={"OOH.Handler":"handler","OOH.IoTAdmin":"iot","ClaimArea.IoT":"iot"}

# Integration-bridge internal read API (DATA_MODE=live; cluster-internal)
BRIDGE_BASE_URL=

# ThingsBoard — read credential + SR-3 scoped WRITE credential (F003 gate)
TB_URL=https://portal.lhlive.co.uk
TB_USERNAME=
TB_PASSWORD=
TB_WRITE_USERNAME=
TB_WRITE_PASSWORD=

# Zendesk API service account
ZENDESK_SUBDOMAIN=
ZENDESK_EMAIL=
ZENDESK_API_TOKEN=

# Cosmos DB durable store (DATA_MODE=live)
COSMOS_ENDPOINT=
COSMOS_KEY=
#COSMOS_DATABASE=ooh-dashboard

# P1 escalation SMS (provider decision pending — Q-F)
SMS_PROVIDER=log         # log | twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
ESCALATION_ONDUTY_NUMBER=
ESCALATION_ONDUTY_NAME=On-duty escalation manager

# IoT Support dashboard base URL for P1 deep-links (F026)
IOT_DASH_BASE_URL=https://zendesk-uat.airedale-api.co.uk

# Tuning (defaults shown)
#SYNC_POLL_INTERVAL_MS=3000
#SYNC_TIMEOUT_MS=90000
#LATE_SYNC_WATCH_MS=600000
#RATE_LIMIT_MAX=240
